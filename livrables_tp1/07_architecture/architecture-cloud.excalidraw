   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Zero trust appliqué :\n- toute requête est authentifiée (clé d'API)\n- une identité par composant, droits minimaux (IAM)\n- chiffrement TLS en transit, AES-256 au repos\n- accès aux secrets tracés (Cloud Audit Logs)",
   "originalText": "Zero trust appliqué :\n- toute requête est authentifiée (clé d'API)\n- une identité par composant, droits minimaux (IAM)\n- chiffrement TLS en transit, AES-256 au repos\n- accès aux secrets tracés (Cloud Audit Logs)",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
   "baseline": 14
  },
