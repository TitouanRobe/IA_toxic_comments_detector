# Variables de déploiement sur Google Cloud, utilisées par toutes les commandes du README.
#
#   cp deploy.env.example deploy.env      # deploy.env est ignoré par git
#   # adapter PROJECT (et REGION si besoin), puis, dans chaque nouveau terminal :
#   source deploy.env
#
# Aucun secret ici : les clés d'API et la clé des logs vont dans Google Secret Manager.

# --- À adapter --------------------------------------------------------------------------------
export PROJECT="mon-projet-gcp"      # identifiant du projet GCP (gcloud projects list)
export REGION="europe-west1"         # région UE (RGPD) ; europe-west9 = Paris
export CLUSTER="toxic-cluster"       # nom du cluster GKE Autopilot
# export DOMAIN="api.mondomaine.fr"  # facultatif : sinon <IP>.sslip.io, sans configuration DNS

# --- Calculé, ne pas modifier -----------------------------------------------------------------
gcloud config set project "$PROJECT" >/dev/null 2>&1
export PROJECT_NUMBER="$(gcloud projects describe "$PROJECT" --format 'value(projectNumber)' 2>/dev/null)"
export REPO="$REGION-docker.pkg.dev/$PROJECT/toxic"
# Identité Workload Identity d'un compte de service Kubernetes : "$WI/<namespace>/sa/<compte>"
export WI="principal://iam.googleapis.com/projects/$PROJECT_NUMBER/locations/global/workloadIdentityPools/$PROJECT.svc.id.goog/subject/ns"
export IP="$(gcloud compute addresses describe toxic-api-ip --global --format 'value(address)' 2>/dev/null)"
export DOMAIN="${DOMAIN:-${IP:+$IP.sslip.io}}"
